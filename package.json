{
  "name": "breathe-together",
  "version": "0.1.0",
  "description": "Wellness breathing coach that adapts pacing to the user's live breathing rate (Presage SmartSpectra SDK Challenge).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/sim/run.ts -- --scenario agitated_then_settling --minutes 1 --seed 7",
    "simulate": "tsx src/sim/run.ts",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}

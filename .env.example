# Copy to `.env` and fill in. Never commit `.env`.
# Server-validated API key from https://physiology.presagetech.com/auth/login
# (Env-var convention is ours, not an official SDK contract — see docs/SDK_NOTES.md open question 1.)
SMARTSPECTRA_API_KEY=

# Which SignalSource the app picks up: "mock" (default) or "sdk".
SIGNAL_SOURCE=mock

# Optional: HTTP/WebSocket port (default 3000).
PORT=3000

# Daily SDK measurement budget in minutes (default 60, see config.ts).
# SDK_TELEMETRY is not a user setting: telemetry is always disabled in our
# wrapper (enableTelemetry: false in src/signal/sdkWorker.ts).
